OH_DEAR_HEALTH_CHECK_SECRET=my-secret-oh-dear-health-check-secret

# --- database ---
# Path to the SQLite database. Unset, it defaults to src/server/data/ahb.db, which is where the
# local development copy lives (see "Setup" in the README). In a container the database is seeded
# into a volume and this points at it, e.g. /data/ahb.db.
# AHB_DB_PATH=/data/ahb.db
#
# Bytes to memory-map. Defaults to 2 GiB, which maps the whole database. Lower it when the
# container has a tight memory limit; raising it above 2 GiB does nothing, as SQLite clamps at
# SQLITE_MAX_MMAP_SIZE. Must be a plain number of bytes.
# AHB_DB_MMAP_SIZE=536870912
#
# Not read by the application. It exists so that bumping the database in a compose file also
# changes the application service's definition, which is what makes `docker compose up -d`
# recreate the container against the newly seeded file. See "Update the database" in the README.
# AHB_DB_VERSION=v2026.08.06.0

# --- frontend runtime configuration ---
# The Express server renders these into /config.js, which index.html loads before the Angular
# bundle. Anything left unset keeps the value compiled into the bundle, so one image serves every
# environment. `ng serve` has no server and therefore always uses the compiled values.
# APP_API_URL=https://ahb-tabellen.hochfrequenz.app
# APP_BASE_URL=https://ahb-tabellen.hochfrequenz.app
# APP_BEDINGUNGSBAUM_BASE_URL=https://bedingungsbaum.hochfrequenz.app
# APP_EBD_BASE_URL=https://ebd.hochfrequenz.app
# APP_FRISTENKALENDER_BASE_URL=https://fristenkalender.hochfrequenz.app
# APP_AUTH0_DOMAIN=auth.hochfrequenz.de
# APP_AUTH0_CLIENT_ID=
# APP_ENTRA_CLIENT_ID=
# APP_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant>
# APP_ENTRA_SCOPES=openid,profile,email
# APP_AUTH0_AUDIENCE=https://ahb-tabellen.hochfrequenz.de/mcp   # = MCP_AUTH0_AUDIENCE; the API audience the SPA requests
# APP_ENTRA_API_SCOPE=api://<entra-mcp-app-client-id-guid>/access_as_user   # api://<MCP_ENTRA_AUDIENCE>/access_as_user
# APP_WARMUP_URL=
# APP_ALLOW_SEARCH_INDEXING=false        # "true" or "false"; anything else fails at startup
# APP_ENABLE_PRUEFI_COMPARISON=true
#
# `isProduction` is deliberately NOT configurable here: it gates the automatic dummy-user login,
# so it stays compiled into the bundle.

# MCP server authentication. The /mcp endpoint is a dual-issuer OAuth resource server: it
# accepts tokens from Auth0 and/or Microsoft Entra ID. The same MCP_* variables also protect
# /api (except /api/health and /api/datenstand). Configure either provider, both, or neither;
# neither = /mcp runs unauthenticated, and the server refuses to start (because /api must not
# be public) unless API_AUTH_DISABLED=true is set. Setting exactly one var of a provider throws
# (fail-closed).
#
# Uncomment for local `npm run server:start` without an MCP_* provider; never on a deployed
# stack. It is ignored when a provider is configured.
#API_AUTH_DISABLED=true

# --- Auth0 ---
# MCP_AUTH0_ISSUER_BASE_URL=https://auth.hochfrequenz.de/
# MCP_AUTH0_AUDIENCE=https://ahb-tabellen.hochfrequenz.de/mcp

# --- Microsoft Entra ID (for a Copilot 365 agent) ---
# MCP_ENTRA_TENANT_ID=<entra-tenant-guid>          # → issuer https://login.microsoftonline.com/<tenant>/v2.0
# For v2 access tokens the `aud` is the Entra resource app's client-id GUID (NOT the api:// URI,
# which is only the requested scope). This is the value the infra Pulumi program injects.
# MCP_ENTRA_AUDIENCE=<entra-mcp-app-client-id-guid> # token `aud` = the resource app's client id
# MCP_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0   # optional override of the derived issuer

# RFC 9728 canonical resource URI (the endpoint's public https URL). Defaults to the first
# provider audience that is an http(s) URL (e.g. the Auth0 audience). REQUIRED for an
# Entra-only deployment, whose api:// audience is not a fetchable resource URL.
# MCP_RESOURCE=https://ahb-tabellen.hochfrequenz.de/mcp

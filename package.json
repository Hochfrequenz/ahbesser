{
  "name": "ahb-tabellen",
  "version": "0.0.0",
  "engines": {
    "node": ">=23.11.0"
  },
  "scripts": {
    "init": "npm run install-submodules",
    "start": "concurrently \"npm run ng:start\" \"npm run server:watch\"",
    "ng:start": "ng serve",
    "ng:build": "ng build",
    "ng:watch": "ng build --watch --configuration development",
    "ng:lint": "ng lint",
    "server:start": "npm run server:build && npm run server:serve",
    "server:serve": "node dist/server/server.js",
    "server:build": "tsc --project tsconfig.server.json",
    "server:watch": "npm-watch server:start",
    "server:lint": "eslint .",
    "format:check": "prettier '**/*.{js,jsx,ts,tsx,html,css,scss,json,yml,md}' --check",
    "format": "prettier '**/*.{js,jsx,ts,tsx,html,css,scss,json,yml,md}' --write",
    "ng-openapi-gen": "ng-openapi-gen --input openapi.yml --output ./src/app/core/api --indexFile=true",
    "lint": "ng lint",
    "install-submodules": "git submodule update --init --recursive",
    "test": "jest .",
    "verify:mcp": "node scripts/verify-mcp.mjs"
  },
  "watch": {
    "server:start": {
      "patterns": [
        "src/server.ts",
        "src/server"
      ],
      "extensions": "ts",
      "quiet": false
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@auth0/auth0-angular": "^2.12.0",
    "@azure/msal-browser": "^5.23.0",
    "@hochfrequenz/efoli": "^2.0.1",
    "@mdi/font": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "prettier": "^3.9.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "sqlite3": "^6.0.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.24",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.70.1",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.28.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "ng-mocks": "^14.18.1",
    "ng-openapi-gen": "^1.1.0",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    }
  }
}
